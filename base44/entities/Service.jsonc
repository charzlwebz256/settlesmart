{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "organization": {
      "type": "string",
      "description": "Organization providing the service"
    },
    "category": {
      "type": "string",
      "enum": [
        "education",
        "language",
        "housing",
        "employment",
        "legal",
        "health",
        "transportation",
        "volunteering",
        "settlement",
        "family_support",
        "financial"
      ],
      "description": "Service category"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the service"
    },
    "eligibility": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Who is eligible: permanent_resident, refugee, international_student, temporary_worker, etc."
    },
    "province": {
      "type": "string",
      "description": "Province or territory"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "address": {
      "type": "string",
      "description": "Physical address"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "languages_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Languages in which the service is available"
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags for search"
    },
    "source_url": {
      "type": "string",
      "description": "URL of the original data source"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "review_due",
        "needs_correction",
        "inactive"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "red",
        "red"
      ],
      "default": "pending",
      "description": "Review state of this record"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the record was last verified"
    },
    "next_review_at": {
      "type": "string",
      "format": "date",
      "description": "Date the record is due for review"
    },
    "verified_by": {
      "type": "string",
      "description": "Reviewer who verified this record"
    },
    "verification_source": {
      "type": "string",
      "description": "URL of the source used to verify this record"
    },
    "verification_notes": {
      "type": "string",
      "description": "Internal reviewer notes (shown only in the admin review screen)",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the organization was last contacted"
    },
    "reported_issue_count": {
      "type": "number",
      "default": 0,
      "description": "Number of open correction reports"
    }
  },
  "required": [
    "name",
    "category",
    "province"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}