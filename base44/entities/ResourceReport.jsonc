{
  "name": "ResourceReport",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "ID of the Service record this report is about"
    },
    "service_name": {
      "type": "string",
      "description": "Service name at the time of the report"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "phone",
        "address",
        "website",
        "eligibility",
        "unavailable",
        "description",
        "other"
      ],
      "enumColors": [
        "gray",
        "gray",
        "blue",
        "yellow",
        "red",
        "yellow",
        "gray"
      ],
      "description": "What is wrong with this resource"
    },
    "details": {
      "type": "string",
      "maxLength": 1000,
      "description": "What the reporter saw and what is correct"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "gray"
      ],
      "default": "open",
      "description": "Administrative review state"
    },
    "admin_notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Internal notes from the reviewer"
    }
  },
  "required": [
    "service_id",
    "issue_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}